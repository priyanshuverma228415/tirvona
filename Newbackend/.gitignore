# ==========================================
# Newbackend (NestJS / Node.js) .gitignore
# ==========================================

# ── Dependencies ─────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
pnpm-debug.log*

# ── Build & Compiled Output ──────────────
dist/
build/
out/
*.tsbuildinfo

# ── Environment & Secret files ───────────
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example

# ── Logs & Runtime ───────────────────────
logs/
*.log
*.pid
*.seed
*.pid.lock

# ── Coverage & Testing ───────────────────
coverage/
.nyc_output/

# ── Temporary & Cache ────────────────────
.cache/
.temp/
.tmp/
temp/
tmp/

# ── OS & Editor Files ────────────────────
.DS_Store
Thumbs.db
Desktop.ini
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
