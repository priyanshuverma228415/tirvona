# ==========================================
# leadTirvona (React / Vite) .gitignore
# ==========================================

# ── Dependencies ─────────────────────────
node_modules/
.pnp
.pnp.js

# ── Production Build Outputs ─────────────
dist/
dist-ssr/
build/
*.local

# ── Environment & Secret files ───────────
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example

# ── Logs & Debugging ─────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── Editor & IDE ─────────────────────────
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ── OS Generated Files ───────────────────
.DS_Store
Thumbs.db
Desktop.ini
